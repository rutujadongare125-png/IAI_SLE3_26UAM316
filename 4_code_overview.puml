
@startuml
title Code Overview - BFS and DFS

left to right direction
skinparam shadowing false

rectangle "BFS Algorithm" as BFS {
  component "Queue" as Q
  component "Visited List" as BV
  Q --> BV
}

rectangle "DFS Algorithm" as DFS {
  component "Stack / Recursion" as S
  component "Visited List" as DV
  S --> DV
}

@enduml




